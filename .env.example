# =============================================================================
# kefu-saas 环境变量示例
#
# 复制为 `.env` 后按需修改。所有应用（api / worker / web / compose）共用本文件
# 顶部的主要变量。`docker compose` 只读取其自身定义的 `${VAR:-default}` 子集：
#
#   - PostgreSQL  : POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB
#   - MinIO       : MINIO_ROOT_USER / MINIO_ROOT_PASSWORD / MINIO_BUCKET
#
# 其余变量由各应用读取。所有默认值均指向本地依赖服务，可直接用于开发。
#
# 环境边界：
#   - APP_ENV=local        本地开发（默认值即本地依赖地址）
#   - APP_ENV=test         自动化测试（与 local 共用同一组本地默认值）
#   - APP_ENV=production   生产 / 试点。关键连接与凭据必须显式提供，缺失时应用拒绝启动。
# =============================================================================

# ---- 运行边界 ----------------------------------------------------------------
APP_ENV=local
NODE_ENV=development
LOG_LEVEL=info

# ---- HTTP ---------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=3000
# 允许跨域访问 API 的来源，逗号分隔。本地 Vite dev server 默认值：
CORS_ORIGINS=http://localhost:5173

# ---- Worker -------------------------------------------------------------------
# WORKER_HEALTH_HOST/PORT 是 Worker health server 的监听地址；API 的 readiness 会探测
# Worker 的 /health/ready（绑定通配地址 0.0.0.0/:: 时按 127.0.0.1 回环访问）。
WORKER_HEALTH_HOST=0.0.0.0
WORKER_HEALTH_PORT=3001
# 所有就绪探测（PostgreSQL/Redis/对象存储/Worker）与整体检查的有限 deadline（毫秒）。
HEALTH_TIMEOUT_MS=1000

# ---- Embedding（知识切片向量化）------------------------------------------------
# Worker 的索引扫描把切片文本发给这里，拿回向量写入 knowledge_chunk_embeddings。
#
# **未设置即不绑定 provider**：EMBEDDING_BASE_URL 与 EMBEDDING_MODEL 任一为空，
# Worker 就不构造 provider（保持 undefined），索引扫描因此**一条都不认领**——
# 认领会消耗一次尝试额度，没有 provider 时认领只会把整张表耗到封顶。
# 结果是所有切片停在 pending，索引状态查询如实报 providerConfigured: false；
# 配好模型后同一套循环会自动把积压捡起来，不需要迁移、不需要重放。
#
# APP_ENV=production 时这两个变量**必填**：缺失即拒绝启动。生产环境里"静默不索引"
# 与"索引很闲"在外观上无法区分，只有启动失败是运维看得见的。
#
# EMBEDDING_BASE_URL 指向兼容 Ollama 的模型服务（本机默认 127.0.0.1:11434）。
# EMBEDDING_MODEL 必须写成模型服务自己报的名字——它会随向量一起落库，并参与
# (tenant_id, chunk_id, embedding_model) 唯一键，写错就是把向量存到了一个
# 再也找不到的地址下。
# EMBEDDING_TIMEOUT_MS 是单次请求的硬 deadline；默认 5000ms 而不是 HEALTH_TIMEOUT_MS
# 的 1000ms，因为模型服务首次请求要先把模型载入内存（本机实测冷启动 2.18s）。
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=
EMBEDDING_TIMEOUT_MS=5000

# ---- Rerank（融合候选的交叉编码重排）--------------------------------------------
# 两条召回腿和它们之间的融合都只读「排名」：关键词腿数命中词数，语义腿量余弦距离，
# 没有任何一步把「问题」和「切片」放进同一个表达式。所以「有棵树内裤 黑色」会把
# 灰色的那条排在前面——管线里没有东西能看出问题里那个颜色词是决定性的。
# 这个服务（`services/retrieval/`）就是那个东西：`bge-reranker-base` 交叉编码器，
# 每对 (问题, 切片) 一次前向，CPU 加载。启动方式见该目录的 README。
#
# **未设置即不绑定 provider**：RERANK_BASE_URL 与 RERANK_MODEL 任一为空，读路径
# 就按融合顺序作答——也就是这个模块出现之前每一次的答案。与嵌入那一对不同，
# 这两个变量在 APP_ENV=production 时**不是必填**：没有嵌入服务是"静默什么都不
# 索引"，外观上与"索引很闲"无法区分，所以必须启动即失败；而没有重排器只是排序
# 差一点，答案依然完整。必填项是留给那些看不见的失败的。
#
# RERANK_MODEL 是**标签不是地址**：它不参与任何行的主键，写错只换来一次 409，
# 不会写坏数据。它随每次请求发出，好让跑着别的模型的侧车拒绝作答，而不是返回
# 一组描述着另一个模型的分数。
# RERANK_TIMEOUT_MS 默认 5000ms，**不是照着最坏情况定的**。一次重排是「每个候选一次
# 前向」，成本全看切片多长：本机实测（2026-09-21，bge-reranker-base / CPU / 20 条候选）
# 对着真实语料是 0.43s，而 chunker 允许的 500 字符 prose 顶格 20 条要 16.2s。
# 不按 16.2s 定，是因为**超了也不丢答案**：deadline 到了 provider 报 AbortError，读路径
# 退回融合顺序，那是个完整答案——也就是重排器出现之前每一次的答案。这条退路正是这个
# 数字可以按「坐席愿意等多久」定、而不必按输入上限定它的原因。
# 语料以长篇 prose 为主的部署，该调小 KNOWLEDGE_RERANK_CANDIDATES 或侧车的
# RERANK_MAX_LENGTH，两者都是配置不是代码。
RERANK_BASE_URL=
RERANK_MODEL=
RERANK_TIMEOUT_MS=5000

# ---- 生成模型（候选话术，DC-DEEPSEEK）------------------------------------------
# **未设置即不绑定 provider**：DEEPSEEK_API_KEY 为空时不绑定生成模型，这是受支持的状态
# 而不是配置错误——候选退回检索结果并写下 no_generation_provider，工作台显示
# 「未配置生成模型，只显示检索到的内容」而不是空白面板。
# 只有**话术库没命中**时才会调用它：话术库命中就直接返回店铺自己写的话术，不花这次调用。
# DEEPSEEK_MODEL 是标签不是地址：suggestion_sets 记录的是 provider 而不是模型名，
# 写错只换来一次 generation_model_not_found，不会污染任何行。
# 密钥只放本地 .env（已被 gitignore）；不要写进这个模板文件，也不要在日志里打印。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT_MS=20000

# ---- PostgreSQL (pgvector) -----------------------------------------------------
# POSTGRES_* 驱动 docker compose 启动的容器；DATABASE_URL 驱动应用连接。
# 修改凭据或库名时三处需保持一致。
POSTGRES_USER=kefu
POSTGRES_PASSWORD=kefu
POSTGRES_DB=kefu
DATABASE_URL=postgres://kefu:kefu@127.0.0.1:5432/kefu

# ---- Redis ---------------------------------------------------------------------
REDIS_URL=redis://127.0.0.1:6379

# ---- MinIO（S3 兼容对象存储，仅限本地/测试的默认凭据）----------------------------
# MINIO_ROOT_* 驱动 docker compose 启动的容器；OBJECT_STORAGE_* 驱动应用连接。
# 两者需要保持一致。
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=media
OBJECT_STORAGE_ENDPOINT=127.0.0.1
OBJECT_STORAGE_PORT=9000
OBJECT_STORAGE_USE_SSL=false
OBJECT_STORAGE_ACCESS_KEY=minioadmin
OBJECT_STORAGE_SECRET_KEY=minioadmin
OBJECT_STORAGE_BUCKET=media

# ---- 媒体取回签名（工作台显示顾客发来的图片）-----------------------------------
# 顾客图片经 API 代理回传（/api/v1/media/:messageId）。<img> 标签带不了身份头，
# 所以 URL 本身就是凭据：租户 + 消息 id + 过期时间 的 HMAC 签名，默认 10 分钟有效。
# 本地默认值是公开的 kefu-local-media-url-secret，仅供本机开发；
# 生产环境必须自设 MEDIA_URL_SECRET —— 持有它的人可以为任意租户签发媒体 URL。
MEDIA_URL_SECRET=kefu-local-media-url-secret

# ---- 企业微信渠道（默认真实微信客服传输；凭证不完整时保持未配置）---------------
# WECOM_TRANSPORT 选择绑定哪种传输：
#   real（默认）  微信客服（/cgi-bin/kf/*）适配器；只在你填入完整凭证后才会真正联网。
#   mock          仅供自动化测试或刻意的本地诊断使用；MVP 产品路径不依赖它。
# WECOM_ENABLED 只是“请求启用”，不代表凭证已配置。接口分别返回
# enableRequested（=WECOM_ENABLED）与 credentialsPresent（对所需字段的实际非空检查结果），
# 二者都不表示已建立企业微信连接；realTransportConnected 只在成功取到 access_token 后为 true。
#
# real 模式必须同时具备下列 5 个变量，缺任意一个时通道状态为 mode: "disabled"，
# 由 missingCredentials 列出缺失的**变量名**（只列名，不列值）：
#   WECOM_CORP_ID  WECOM_KF_SECRET  WECOM_TOKEN  WECOM_AES_KEY  WECOM_OPEN_KFID
# 注意：WECOM_SECRET / WECOM_AGENT_ID 属于自建应用，**不能**代替 WECOM_KF_SECRET——
# 自 2023-12-01 起微信客服接口不再接受自建应用 secret，代码不会做任何回退。
# 请勿把真实凭证提交进版本库；以下字段一律留空，按需在本地 .env 中填写。
WECOM_ENABLED=false
WECOM_TRANSPORT=real
WECOM_CORP_ID=
WECOM_AGENT_ID=
WECOM_SECRET=
WECOM_TOKEN=
WECOM_AES_KEY=
# 微信客服专用应用 secret（WECOM_KF_SECRET）与客服账号 open_kfid（WECOM_OPEN_KFID）
WECOM_KF_SECRET=
WECOM_OPEN_KFID=
#
# 真实回调用法：
#   入向消息回调  POST /api/v1/channels/wecom/webhook
#   投递状态回调  POST /api/v1/channels/wecom/status
#   投递详情/重试 GET  /api/v1/channels/deliveries/:deliveryId
#                 POST /api/v1/channels/deliveries/:deliveryId/retry
#   真实回调签名      query 参数 msg_signature / timestamp / nonce（对原始报文取 sha1）
#   URL 校验（GET）   /api/v1/channels/wecom/callback?msg_signature=&timestamp=&nonce=&echostr=
#                     校验通过时直接返回解密后的 echostr 明文（无 JSON 信封、无多余换行）
#
# 客服服务窗口规则（与真实企业微信一致）：最近一次顾客入向消息开启 48 小时回复窗口，窗口内
# 最多 5 条逻辑回复；超出窗口或超出条数会在调用适配器**之前**被拒绝，并返回可见的降级原因。

# ---- 认证与访问控制 ------------------------------------------------------------
# AUTH_STORAGE 决定认证状态的存放位置：auto 跟随环境边界（test 用进程内确定性适配器，
# local/production 用 PostgreSQL）；也可显式设为 memory 或 postgres。
AUTH_STORAGE=auto
# 生产环境必须显式命名真实的一次性验证码 / OIDC 提供方；留空时平台会"失败关闭"
# （provider_not_configured），而不是假装发送或接受一个无人验证的凭证。
# local 与 test 始终使用确定性本地提供方，无需网络调用。
AUTH_OTP_PROVIDER=
AUTH_OIDC_PROVIDER=
# 本地 OIDC 身份命名所用的签发方键。
AUTH_OIDC_ISSUER=local-oidc
# x-member-id / x-tenant-id 演示身份头。生产环境**始终**拒绝；test 环境始终接受；
# local 环境需显式置为 true 才接受。控制台已改用 Bearer 会话（npm run db:seed 写入的
# 本地管理员密码，见 README），因此本地也默认关闭；仅在需要以演示头临时冒用身份时才开启。
AUTH_DEMO_IDENTITY_HEADERS=false
# 仅本地开发：是否允许 POST /api/v1/auth/otp/send 在响应中回显本次下发的一次性验证码。
# 默认 false。三个条件同时成立时才会回显——APP_ENV=local、显式置为 true、且实际解析到的
# 提供方就是进程内的确定性本地提供方（LocalOtpProvider）；生产环境一律不返回验证码，
# 该值在生产环境不产生任何效果（日志、错误、数据库、管理接口也从不携带验证码）。
AUTH_DEVELOPMENT_OTP_VISIBLE=false
