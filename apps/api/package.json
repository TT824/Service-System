{
  "name": "@kefu/api",
  "version": "0.1.0",
  "private": true,
  "description": "NestJS HTTP API for the kefu-saas platform (versioned /api/v1 surface, health, request ids, stable errors).",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "predev": "tsc -p tsconfig.build.json",
    "dev": "node --watch dist/main.js",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@kefu/core": "0.1.0",
    "@kefu/wecom": "0.1.0",
    "@nestjs/common": "^10.4.22",
    "@nestjs/core": "^10.4.22",
    "@nestjs/platform-express": "^10.4.22",
    "dotenv": "^16.4.5",
    "ioredis": "^5.11.1",
    "minio": "^8.0.7",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/testing": "^10.4.22",
    "@types/express": "^4.17.25",
    "@types/node": "^22.7.5",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "typescript": "~5.6.3"
  }
}
