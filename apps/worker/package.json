{
  "name": "@kefu/worker",
  "version": "0.1.0",
  "private": true,
  "description": "NestJS worker for the kefu-saas platform: runnable bootstrap, health/readiness contract, and the channel-outbox delivery processor.",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "predev": "tsc -p tsconfig.build.json",
    "dev": "node --watch dist/main.js",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@kefu/core": "0.1.0",
    "@kefu/wecom": "0.1.0",
    "@nestjs/common": "^10.4.22",
    "@nestjs/core": "^10.4.22",
    "dotenv": "^16.4.5",
    "ioredis": "^5.11.1",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "@types/pg": "^8.11.10",
    "typescript": "~5.6.3"
  }
}
