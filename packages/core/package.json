{
  "name": "@kefu/core",
  "version": "0.1.0",
  "private": true,
  "description": "Shared pure TypeScript primitives for the kefu-saas monorepo (request id, error contract, app config parsing, redaction).",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "csv-parse": "^7.0.2",
    "exceljs": "^4.4.0",
    "jszip": "^3.10.2",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "typescript": "~5.6.3"
  }
}
